{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"transit": {
			"dependsOn": ["^transit"]
		},
		// Internal packages export source `.ts`, so a consumer type-checks its
		// dependencies' source too — no `^build` needed. Depending on the transit
		// node keeps the cache correct (a dep's source change busts us) while still
		// letting every package check in parallel.
		"typecheck": {
			"dependsOn": ["transit"]
		},
		"build": {
			"dependsOn": ["transit"],
			"outputs": ["dist/**", "out/**", "native/build/**", "native/Spud.app/**"],
			"outputLogs": "new-only"
		},
		"@justfiles/spud-macos#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"package.json",
				"daemon/**",
				"ui/**",
				"native/Package.swift",
				"native/Sources/**",
				"native/build.sh"
			],
			"outputs": ["native/build/**", "native/Spud.app/**"],
			"outputLogs": "new-only"
		},
		"dev": {
			"dependsOn": ["transit"],
			"cache": false,
			"persistent": true
		},
		"frieren#dev": {
			"dependsOn": [
				"@justfiles/app-files#build",
				"@justfiles/app-paint#build",
				"@justfiles/app-settings#build",
				"transit"
			],
			"cache": false,
			"persistent": true
		}
	}
}
