{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"transit": {
			"dependsOn": ["^transit"]
		},
		"build": {
			"dependsOn": ["transit"],
			"outputs": ["dist/**", "out/**", "native/build/**", "native/Quay.app/**"],
			"outputLogs": "new-only"
		},
		"@justfiles/quay#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"package.json",
				"quayd/**",
				"launcher-ui/**",
				"native/Package.swift",
				"native/Sources/**",
				"native/build.sh"
			],
			"outputs": ["native/build/**", "native/Quay.app/**"],
			"outputLogs": "new-only"
		},
		"dev": {
			"dependsOn": ["transit"],
			"cache": false,
			"persistent": true
		},
		"frieren#dev": {
			"dependsOn": [
				"@justfiles/app-code#build",
				"@justfiles/app-files#build",
				"@justfiles/app-paint#build",
				"@justfiles/app-settings#build",
				"transit"
			],
			"cache": false,
			"persistent": true
		}
	}
}
