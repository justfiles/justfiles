{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"transit": {
			"dependsOn": ["^transit"]
		},
		// Internal packages export source `.ts`, so a consumer type-checks its
		// dependencies' source too — no `^build` needed. Depending on the transit
		// node keeps the cache correct (a dep's source change busts us) while still
		// letting every package check in parallel.
		"typecheck": {
			"dependsOn": ["transit"]
		},
		"build": {
			"dependsOn": ["transit"],
			"outputs": ["dist/**", "out/**", "native/build/**", "native/Kodama.app/**"],
			"outputLogs": "new-only"
		},
		// `^build` is the whole dependency story for the Mac app: every built-in the
		// daemon seeds (daemon/builtins.ts) is a `workspace:*` dep, so turbo derives the
		// list from package.json and there is nothing to keep in step by hand. The
		// scripts are leaves — run `turbo run build` / `turbo run dev` from apps/mac
		// (auto-scoped) and turbo, not a prebuild step, orders the dep builds.
		"@justfiles/frieren-mac#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"package.json",
				"daemon/**",
				"ui/**",
				"native/Package.swift",
				"native/Sources/**",
				"native/build.sh"
			],
			"outputs": ["native/build/**", "native/Kodama.app/**"],
			"outputLogs": "new-only"
		},
		"dev": {
			"dependsOn": ["transit"],
			"cache": false,
			"persistent": true
		},
		// The daemon reads each built-in's `dist/manifest.json` at boot and throws
		// ("build the app first") if it is missing, so dev needs the same `^build` as the
		// ship build — otherwise a fresh checkout cannot start the dev daemon at all.
		"@justfiles/frieren-mac#dev": {
			"dependsOn": ["^build", "transit"],
			"cache": false,
			"persistent": true
		},
		"frieren#dev": {
		// Every built-in in `apps/frieren/vite-appstore.ts`'s BUILTIN_DIRS, because
			// the appstore plugin reads each one's `dist` at `buildStart` and throws
			// ENOENT on a fresh checkout otherwise. Keep in step with that list and with
			// frieren's `build-apps` script.
			"dependsOn": [
				"@justfiles/app-files#build",
				"@justfiles/app-settings#build",
				"transit"
			],
			"cache": false,
			"persistent": true
		}
	}
}
