{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": [".node-version", ".npmrc", "pnpm-workspace.yaml", "platform/shared/**"],
	"globalPassThroughEnv": ["PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN"],
	"tasks": {
		"transit": {
			"dependsOn": ["^transit"]
		},
		// Internal packages export source `.ts`, so a consumer type-checks its
		// dependencies' source too — no `^build` needed. Depending on the transit
		// node keeps the cache correct (a dep's source change busts us) while still
		// letting every package check in parallel.
		"typecheck": {
			"dependsOn": ["transit"]
		},
		"build": {
			"dependsOn": ["transit"],
			"outputs": ["dist/**", "out/**", "native/build/**", "native/Just Computer.app/**"],
			"outputLogs": "new-only"
		},
		// `^build` is the whole dependency story for the Mac app: every built-in the
		// daemon seeds (daemon/builtins.ts) is a `workspace:*` dep, so turbo derives the
		// list from package.json and there is nothing to keep in step by hand. The
		// scripts are leaves — run `turbo run build` / `turbo run dev` from platform/mac
		// (auto-scoped) and turbo, not a prebuild step, orders the dep builds.
		"@justfiles/frieren-mac#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"package.json",
				"daemon/**",
				"ui/**",
				"native/Package.swift",
				"native/Sources/**",
				"native/build.sh"
			],
			"outputs": ["native/build/**", "native/Just Computer.app/**"],
			"outputLogs": "new-only"
		},
		"dev": {
			"dependsOn": ["transit"],
			"cache": false,
			"persistent": true
		},
		"@justfiles/frieren-mac#dev": {
			"dependsOn": ["^build", "transit"],
			"cache": false,
			"persistent": true
		},
		"frieren#dev": {
			"dependsOn": ["transit"],
			"env": ["FRIEREN_DEV_APPS", "VITE_FRIEREN_DEV_APP_STORE"],
			"cache": false,
			"persistent": true
		}
	}
}
