{
	"name": "frieren",
	"private": true,
	"version": "0.14.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"build-apps": "turbo run build --filter @justfiles/app-code --filter @justfiles/app-files --filter @justfiles/app-settings --filter @justfiles/app-dictionary",
		"lint": "eslint .",
		"auth:token": "tsx scripts/frieren-auth.ts token",
		"seed:llm-user": "tsx scripts/frieren-auth.ts seed",
		"auth:bootstrap": "tsx scripts/frieren-auth.ts bootstrap",
		"verify:ui": "tsx scripts/frieren-auth.ts ui",
		"verify:sandbox": "tsx scripts/reducer-frame-probe.ts",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"icons": "tsx scripts/generate-icons.ts",
		"faces": "tsx scripts/generate-faces.ts",
		"avatars": "node scripts/bake-avatars.ts",
		"typecheck": "tsc -b --noEmit"
	},
	"dependencies": {
		"@clerk/backend": "^3.2.9",
		"@clerk/clerk-react": "^5.61.3",
		"@clerk/hono": "^0.1.11",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@hono/clerk-auth": "^3.1.1",
		"@justfiles/agent": "workspace:*",
		"@justfiles/app": "workspace:*",
		"@justfiles/app-code": "workspace:*",
		"@justfiles/app-dictionary": "workspace:*",
		"@justfiles/app-files": "workspace:*",
		"@justfiles/app-settings": "workspace:*",
		"@justfiles/core": "workspace:*",
		"@justfiles/design": "workspace:*",
		"@justfiles/fs": "workspace:*",
		"@justfiles/state": "workspace:*",
		"@justfiles/sync": "workspace:*",
		"@justfiles/ui": "workspace:*",
		"@earendil-works/pi-agent-core": "^0.80.10",
		"@earendil-works/pi-ai": "^0.80.10",
		"@phosphor-icons/react": "^2.1.10",
		"esbuild-wasm": "^0.27.7",
		"fflate": "^0.8.3",
		"hono": "4.11.1",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"typebox": "^1.1.33",
		"valibot": "^1.4.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.31.2",
		"@eslint/js": "^9.39.1",
		"@justfiles/tsconfig": "workspace:*",
		"@playwright/cli": "^0.1.13",
		"@playwright/test": "^1.59.1",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"esbuild": "^0.27.7",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"sharp": "^0.34.5",
		"tsx": "^4.21.0",
		"typescript": "catalog:",
		"typescript-eslint": "^8.48.0",
		"vite": "^8.0.0-beta.13",
		"vite-plugin-pwa": "^1.3.0",
		"workbox-window": "^7.4.0",
		"wrangler": "^4.118.0"
	},
	"overrides": {
		"vite": "^8.0.0-beta.13"
	}
}
