{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "frieren",
	"main": "worker/index.ts",
	"compatibility_date": "2026-04-10",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/apps/*", "/api/*", "/fs/*", "/ws"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	"secrets": {
		"required": ["CLERK_SECRET_KEY", "OPENAI_API_KEY", "INTEGRATION_KEY"]
	},
	"vars": {
		"CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuanVzdGJ1ZGR5LmFwcCQ"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "FRIEREN",
				"class_name": "Frieren"
			}
		]
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"r2_buckets": [
		{
			"binding": "FS_BLOBS",
			"bucket_name": "frieren-fs-blobs"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Frieren"]
		}
	],
	"routes": [
		{
			"pattern": "justbuddy.app",
			"custom_domain": true
		}
	],
	"env": {
		"staging": {
			"name": "frieren-staging",
			"vars": {
				"CLERK_PUBLISHABLE_KEY": "pk_test_Y2FwYWJsZS1zcGlkZXItNzkuY2xlcmsuYWNjb3VudHMuZGV2JA"
			},
			"observability": {
				"enabled": true
			},
			"secrets": {
				"required": ["CLERK_SECRET_KEY", "OPENAI_API_KEY", "INTEGRATION_KEY"]
			},
			"routes": [
				{
					"pattern": "staging.justbuddy.app",
					"custom_domain": true
				}
			],
			"r2_buckets": [
				{
					"binding": "FS_BLOBS",
					"bucket_name": "frieren-staging-fs-blobs"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "FRIEREN",
						"class_name": "Frieren"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": ["Frieren"]
				}
			]
		}
	}
}
