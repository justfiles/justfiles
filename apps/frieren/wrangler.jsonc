{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "frieren",
	"main": "worker/index.ts",
	"compatibility_date": "2026-04-10",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/apps/*", "/api/*", "/fs/*", "/ws"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	"secrets": {
		"required": ["CLERK_SECRET_KEY", "OPENAI_API_KEY"]
	},
	"vars": {
		"CLERK_PUBLISHABLE_KEY": "pk_test_Y2FwYWJsZS1zcGlkZXItNzkuY2xlcmsuYWNjb3VudHMuZGV2JA"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "FRIEREN",
				"class_name": "Frieren"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Frieren"]
		}
	],
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"env": {
		"staging": {
			"name": "frieren-staging",
			"vars": {
				"CLERK_PUBLISHABLE_KEY": "pk_test_Y2FwYWJsZS1zcGlkZXItNzkuY2xlcmsuYWNjb3VudHMuZGV2JA"
			},
			"observability": {
				"enabled": true
			},
			"durable_objects": {
				"bindings": [
					{
						"name": "FRIEREN",
						"class_name": "Frieren"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": ["Frieren"]
				}
			]
		}
	}
}
