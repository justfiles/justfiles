	},
	"durable_objects": {
		"bindings": [
			{
				"name": "FRIEREN",
				"class_name": "Frieren"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Frieren"]
		}
	]
}
