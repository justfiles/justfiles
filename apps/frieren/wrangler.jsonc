{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "frieren",
	"main": "worker/index.ts",
	"compatibility_date": "2026-04-10",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "FRIEREN",
				"class_name": "Frieren"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Frieren"]
		}
	]
}
