{
	"extends": "@justfiles/tsconfig/base.json",
	"compilerOptions": {
		"lib": ["ES2023"],
		"types": ["node", "bun"],
		// The daemon runs under Bun (`bun daemon/main.ts`); resolve the `bun` export
		// condition so the `#`-import bun variants and Bun-specific helpers type-check
		// against what actually runs.
		"customConditions": ["bun"],
		// Not enabled: `@justfiles/agent` is consumed un-built (TS source), and its
		// internals aren't clean under noUncheckedIndexedAccess — matching frieren.
		"noImplicitOverride": true
	},
	// ui/vendor.ts + ui/vite.config.ts are node-side (esbuild/vite build tooling); the
	// browser entries under ui/ are typechecked by tsconfig.browser.json instead.
	"include": ["daemon/**/*.ts", "ui/vendor.ts", "ui/vite.config.ts"]
}
