/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "runner",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-03",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Zone apex the Worker is bound to; the first host label under it is the app id.
	"vars": {
		"ROOT_DOMAIN": "justapps.run",
		"CLERK_ISSUER": "https://clerk.mykodama.app"
	},
	// Everything we host: the catalog snapshot, per-app state, and every release's
	// bytes. See kb/registry.md for the key layout.
	"r2_buckets": [
		{
			"binding": "STORE",
			"bucket_name": "runner-store"
		}
	],
	// Production gets its database_id during rollout. Local dev uses Wrangler's
	// local D1 store without reaching a cloud database.
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "runner-auth",
			"migrations_dir": "migrations"
		}
	],
	// Reading a public repo still needs a token: unauthenticated GitHub is 60
	// requests/hour *per IP*, and a Worker's egress IP is shared.
	"secrets": {
		"required": ["GITHUB_TOKEN", "TOKEN_SEAL_KEY_V1", "CLERK_CLIENT_ID", "CLERK_CLIENT_SECRET"]
	},
	// Hourly, and deliberately not more often: a cron on an interval of an hour
	// or more gets 15 minutes of CPU, where a sub-hourly one gets 30 seconds.
	"triggers": {
		"crons": ["0 * * * *"]
	},
	// Custom Domains cannot be wildcards, so subdomains need a route + a proxied
	// wildcard DNS record (`*` AAAA `100::`, proxied) on the zone.
	"routes": [
		{
			"pattern": "justapps.run",
			"custom_domain": true
		},
		{
			"pattern": "*.justapps.run/*",
			"zone_name": "justapps.run"
		}
	],
	// `wrangler dev -e dev`: with no routes the local server keeps the request's
	// Host header, so `http://app1.localhost:8787` reaches the Worker as app1.
	// (With routes configured, wrangler rewrites every request to the zone apex.)
	// Bindings are not inherited by a named environment, so anything above that
	// `dev` also needs has to be repeated here.
	"env": {
		"dev": {
			"routes": [],
			"vars": {
				"ROOT_DOMAIN": "justapps.run",
				"CLERK_ISSUER": "https://capable-spider-79.clerk.accounts.dev"
			},
			"r2_buckets": [
				{
					"binding": "STORE",
					"bucket_name": "runner-store"
				}
			],
			"d1_databases": [
				{
					"binding": "AUTH_DB",
					"database_name": "runner-auth",
					"migrations_dir": "migrations"
				}
			],
			"secrets": {
				"required": ["GITHUB_TOKEN", "TOKEN_SEAL_KEY_V1", "CLERK_CLIENT_ID", "CLERK_CLIENT_SECRET"]
			}
		}
	}
}
