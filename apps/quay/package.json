{
	"name": "@justfiles/quay",
	"type": "module",
	"private": true,
	"scripts": {
		"typecheck": "tsc --noEmit",
		"quayd": "node --import ./quayd/rawLoader.mjs --import tsx quayd/main.ts",
		"build": "native/build.sh --launcher",
		"start": "pkill -f Quay.app/Contents/MacOS/Quay 2>/dev/null; open native/Quay.app"
	},
	"dependencies": {
		"@justfiles/agent": "workspace:*",
		"@justfiles/app": "workspace:*",
		"@justfiles/app-code": "workspace:*",
		"@justfiles/app-counter": "workspace:*",
		"@justfiles/app-finder": "workspace:*",
		"@justfiles/fs": "workspace:*",
		"capnweb": "^0.8.0",
		"esbuild": "^0.27.0",
		"react": "^19",
		"react-dom": "^19",
		"ws": "^8.20.1"
	},
	"devDependencies": {
		"@types/node": "^25.7.0",
		"@types/ws": "^8.5.13",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3"
	}
}
