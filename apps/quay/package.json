{
	"name": "@justfiles/quay",
	"type": "module",
	"private": true,
	"imports": {
		"#sandbox-url": {
			"bun": "./quayd/sandboxUrl.bun.ts",
			"node": "./quayd/sandboxUrl.node.ts",
			"default": "./quayd/sandboxUrl.node.ts"
		},
		"#engine": {
			"bun": "./quayd/devkitEngine.bun.ts",
			"node": "./quayd/devkitEngine.node.ts",
			"default": "./quayd/devkitEngine.node.ts"
		},
		"#assets": {
			"bun": "./quayd/assetsBundler.bun.ts",
			"node": "./quayd/assetsBundler.node.ts",
			"default": "./quayd/assetsBundler.node.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"daemon": "bun --watch daemon/main.ts",
		"vendor": "bun daemon/vendor.ts",
		"dev": "turbo run build --filter=@justfiles/quay^... && native/build.sh --launcher && native/relaunch.sh",
		"build": "turbo run build --filter=@justfiles/quay^... && native/build.sh --ship-daemon",
		"build:quayd": "turbo run build --filter=@justfiles/quay^... && native/build.sh --ship",
		"start": "open -n native/Quay.app",
		"install:app": "pnpm build && native/install.sh",
		"quayd": "node --import ./quayd/rawLoader.mjs --import tsx quayd/main.ts"
	},
	"dependencies": {
		"@justfiles/agent": "workspace:*",
		"@justfiles/app": "workspace:*",
		"@justfiles/app-code": "workspace:*",
		"@justfiles/app-counter": "workspace:*",
		"@justfiles/app-files": "workspace:*",
		"@justfiles/app-notes": "workspace:*",
		"@justfiles/app-paint": "workspace:*",
		"@justfiles/app-settings": "workspace:*",
		"@justfiles/design": "workspace:*",
		"@justfiles/fs": "workspace:*",
		"@justfiles/ui": "workspace:*",
		"@mariozechner/pi-ai": "^0.70.2",
		"capnweb": "^0.8.0",
		"esbuild": "^0.27.0",
		"hono": "4.11.1",
		"react": "^19",
		"react-dom": "^19",
		"typescript": "^6.0.3",
		"ws": "^8.20.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3.0",
		"@types/node": "^25.7.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/ws": "^8.5.13",
		"cjs-module-lexer": "^2.2.0",
		"tsx": "^4.21.0"
	}
}
