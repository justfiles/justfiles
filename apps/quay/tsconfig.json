{
	"compilerOptions": {
		"lib": ["ESNext"],
		"types": ["node"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		// Not enabled: `@justfiles/agent` is consumed un-built (TS source), and its
		// internals aren't clean under noUncheckedIndexedAccess — matching how
		// frieren/desktop typecheck the same source.
		"noImplicitOverride": true
	},
	"include": ["quayd/**/*.ts"]
}
