{
	"compilerOptions": {
		"lib": ["ESNext"],
		"types": ["node", "bun"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		// The daemon runs under Bun (`bun daemon/main.ts`); resolve the `bun` export
		// condition so capnweb's Bun helpers and the `#`-import bun variants type-check
		// against what actually runs.
		"customConditions": ["bun"],
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		// Not enabled: `@justfiles/agent` is consumed un-built (TS source), and its
		// internals aren't clean under noUncheckedIndexedAccess — matching how
		// frieren/desktop typecheck the same source.
		"noImplicitOverride": true
	},
	"include": ["quayd/**/*.ts", "daemon/**/*.ts"]
}
