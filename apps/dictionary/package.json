{
	"name": "app-dictionary",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.24.0",
	"description": "A learning-aware dictionary for JustFiles.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/justfiles/app-dictionary.git"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "biome format --write .",
		"lint": "biome ci .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@justfiles/app": "^0.7.0",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"typescript": "6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
