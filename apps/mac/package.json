{
	"name": "@justfiles/frieren-mac",
	"type": "module",
	"private": true,
	"scripts": {
		"typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit",
		"dev": "pnpm ui:build && concurrently -k -n ui,daemon 'pnpm ui:watch' 'pnpm daemon'",
		"daemon": "bun --watch daemon/main.ts",
		"ui:build": "vite build -c ui/vite.config.ts",
		"ui:watch": "vite build -c ui/vite.config.ts --watch",
		"build": "native/build.sh --ship-daemon",
		"start": "open -n native/Kodama.app",
		"install:app": "turbo run build && native/install.sh"
	},
	"dependencies": {
		"@justfiles/agent": "workspace:*",
		"@justfiles/app": "workspace:*",
		"@justfiles/app-files": "workspace:*",
		"@justfiles/app-settings": "workspace:*",
		"@justfiles/design": "workspace:*",
		"@justfiles/fs": "workspace:*",
		"@justfiles/ui": "workspace:*",
		"@earendil-works/pi-ai": "^0.80.10",
		"react": "^19",
		"react-dom": "^19",
		"typescript": "catalog:"
	},
	"devDependencies": {
		"@justfiles/tsconfig": "workspace:*",
		"@types/bun": "^1.3.0",
		"@types/node": "^25.7.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"concurrently": "^9.2.0",
		"vite": "^8.0.16"
	}
}
