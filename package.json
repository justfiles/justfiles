		"publish": true
	},
	"dependencies": {
		"@clerk/clerk-react": "^5.0.0",
		"@hono/clerk-auth": "^3.1.0",
		"@hono/mcp": "^0.2.4",
		"@hono/zod-validator": "^0.7.6",
		"@libsql/client": "^0.17.0",
		"@milkdown/kit": "^7.19.0",
		"@milkdown/react": "^7.19.0",
		"@modelcontextprotocol/sdk": "^1.27.1",
		"@tailwindcss/vite": "^4.2.1",
		"@tanstack/react-router": "^1.166.7",
		"@tursodatabase/database": "^0.4.0",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.1",
		"hono": "4.11.1",
		"hono-rate-limiter": "^0.5.3",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"tailwindcss": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@cloudflare/vite-plugin": "1.15.3",
		"@eslint/js": "9.39.1",
		"@tailwindcss/typography": "^0.5.19",
		"@types/node": "^25.3.4",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"drizzle-kit": "^0.31.9",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"tsx": "^4.21.0",
		"typescript": "5.8.3",
		"typescript-eslint": "8.48.0",
		"vite": "^6.0.0",
		"wrangler": "^4.71.0"
	},
	"private": true,
	"bin": {
		"ghostore": "./src/cli/index.ts"
	},
	"scripts": {
		"dev:local": "bun run --hot src/local/index.tsx",
		"db:generate": "drizzle-kit generate",
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"check": "tsc -b && vite build && wrangler deploy --dry-run",
		"format": "biome check --write src",
		"preview": "npm run build && vite preview",
		"mcp:inspect": "bunx @modelcontextprotocol/inspector https://ghostore.net/mcp"
	},
	"type": "module"
}
