{
	"name": "ghostore-monorepo",
	"packageManager": "pnpm@10.33.0",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@vitest/coverage-v8": "^4.0.18",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"build": "pnpm -r --if-present build",
		"dev": "pnpm --filter @justfiles/worker dev",
		"format": "biome format --write .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
