{
	"name": "ghostore-monorepo",
	"packageManager": "pnpm@11.2.2",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@vitest/coverage-v8": "^4.0.18",
		"turbo": "^2.9.18",
		"typescript": "6.0.3",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev --filter frieren",
		"format": "biome format --write .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
