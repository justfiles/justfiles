{
	"name": "ghostore-monorepo",
	"packageManager": "pnpm@11.2.2",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@vitest/coverage-v8": "^4.0.18",
		"tsx": "^4.21.0",
		"turbo": "^2.9.18",
		"typescript": "catalog:",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"build": "PNPM_CONFIG_PM_ON_FAIL=ignore PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false turbo run build",
		"dev": "PNPM_CONFIG_PM_ON_FAIL=ignore PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false node platform/frieren/scripts/dev.ts",
		"format": "biome format --write platform apps/crossword apps/doom apps/pixel packages",
		"lint": "biome ci platform apps/crossword apps/doom apps/pixel packages",
		"lint:fix": "biome check --write platform apps/crossword apps/doom apps/pixel packages",
		"typecheck": "PNPM_CONFIG_PM_ON_FAIL=ignore PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false turbo run typecheck",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
