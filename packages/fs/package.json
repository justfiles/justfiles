{
	"name": "@justfiles/fs",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@justfiles/src": "./index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./storage": {
			"@justfiles/src": "./storage.ts",
			"import": "./dist/storage.js",
			"default": "./dist/storage.js"
		},
		"./storage/mem": {
			"@justfiles/src": "./storage.mem.ts",
			"import": "./dist/storage.mem.js",
			"default": "./dist/storage.mem.js"
		},
		"./storage/idb": {
			"@justfiles/src": "./storage.idb.ts",
			"import": "./dist/storage.idb.js",
			"default": "./dist/storage.idb.js"
		},
		"./storage/fs": {
			"@justfiles/src": "./storage.fs.ts",
			"import": "./dist/storage.fs.js",
			"default": "./dist/storage.fs.js"
		},
		"./types": {
			"@justfiles/src": "./types.ts",
			"import": "./dist/types.js",
			"default": "./dist/types.js"
		},
		"./xattr": {
			"@justfiles/src": "./xattr.ts",
			"import": "./dist/xattr.js",
			"default": "./dist/xattr.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"idb": "^8.0.3"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^25.5.0",
		"tsdown": "^0.21.5",
		"typescript": "^5"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
