{
	"name": "@justfiles/fs",
	"version": "0.2.1",
	"type": "module",
	"exports": {
		".": "./index.ts",
		"./storage": "./storage.ts",
		"./sync-wire": "./sync-wire.ts",
		"./sync-replica": "./sync-replica.ts",
		"./storage/mem": "./storage.mem.ts",
		"./storage/idb": "./storage.idb.ts",
		"./storage/fs": "./storage.fs.ts",
		"./types": "./types.ts",
		"./xattr": "./xattr.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"module": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./storage": {
				"types": "./dist/storage.d.ts",
				"import": "./dist/storage.js",
				"default": "./dist/storage.js"
			},
			"./sync-wire": {
				"types": "./dist/sync-wire.d.ts",
				"import": "./dist/sync-wire.js",
				"default": "./dist/sync-wire.js"
			},
			"./sync-replica": {
				"types": "./dist/sync-replica.d.ts",
				"import": "./dist/sync-replica.js",
				"default": "./dist/sync-replica.js"
			},
			"./storage/mem": {
				"types": "./dist/storage.mem.d.ts",
				"import": "./dist/storage.mem.js",
				"default": "./dist/storage.mem.js"
			},
			"./storage/idb": {
				"types": "./dist/storage.idb.d.ts",
				"import": "./dist/storage.idb.js",
				"default": "./dist/storage.idb.js"
			},
			"./storage/fs": {
				"types": "./dist/storage.fs.d.ts",
				"import": "./dist/storage.fs.js",
				"default": "./dist/storage.fs.js"
			},
			"./types": {
				"types": "./dist/types.d.ts",
				"import": "./dist/types.js",
				"default": "./dist/types.js"
			},
			"./xattr": {
				"types": "./dist/xattr.d.ts",
				"import": "./dist/xattr.js",
				"default": "./dist/xattr.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"idb": "^8.0.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"tsdown": "^0.21.5",
		"typescript": "^5"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
