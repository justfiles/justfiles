	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"idb": "^8.0.3"
	},
	"devDependencies": {
		"@justfiles/tsconfig": "workspace:*",
		"@types/node": "^25.5.0",
		"fake-indexeddb": "^6.2.5",
