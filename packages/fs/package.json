{
	"name": "@justfiles/fs",
	"version": "0.6.0",
	"type": "module",
	"exports": {
		".": "./index.ts",
		"./storage": "./storage.ts",
		"./storage.shared": "./storage.shared.ts",
		"./persistedState": "./persistedState.ts",
