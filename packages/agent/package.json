{
	"name": "@justfiles/agent",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./index.ts",
		"./defaults": "./agent-defaults.ts",
		"./expression": "./expression.ts",
		"./avatars": "./avatars.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./defaults": {
				"types": "./dist/agent-defaults.d.ts",
				"default": "./dist/agent-defaults.js"
			},
			"./expression": {
				"types": "./dist/expression.d.ts",
				"default": "./dist/expression.js"
			},
			"./avatars": {
				"types": "./dist/avatars.d.ts",
				"default": "./dist/avatars.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@justfiles/app": "workspace:*",
		"@justfiles/fs": "workspace:*",
		"@justfiles/sync": "workspace:*",
		"@earendil-works/pi-agent-core": "^0.80.10",
		"@earendil-works/pi-ai": "^0.80.10",
		"just-bash": "3.0.2",
		"typebox": "^1.1.33",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@justfiles/tsconfig": "workspace:*",
		"@types/node": "^25.7.0",
		"typescript": "catalog:"
	}
}
