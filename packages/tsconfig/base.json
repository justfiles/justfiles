{
	"$schema": "https://json-schema.org/draft-07/schema",
	"display": "Base",
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true
	}
}
