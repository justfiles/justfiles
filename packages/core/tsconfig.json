{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	},
	"include": ["src"],
	// `*.bun.test.ts` runs under `bun test` (needs bun:sqlite/bun:test) — the CI
	// Bun half. tsc has no @types/bun, so skip it here (mirrors vitest's exclude).
	"exclude": ["**/*.bun.test.ts"]
}
