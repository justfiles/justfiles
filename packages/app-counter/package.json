{
	"name": "@spud-computer/counter",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/manifest.json",
	"keywords": [
		"spud-app"
	],
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"pack": "rm -f app.zip && cd dist && zip -r ../app.zip .",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@justfiles/app": "workspace:*",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@justfiles/tsconfig": "workspace:*",
		"esbuild": "^0.27.0",
		"typescript": "catalog:",
		"vite": "^8.0.12"
	}
}
