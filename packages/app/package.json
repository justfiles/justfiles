{
	"name": "@justfiles/app",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@justfiles/src": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./server": {
			"@justfiles/src": "./server.ts",
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		},
		"./client": {
			"@justfiles/src": "./client.js",
			"types": "./client.d.ts",
			"default": "./client.js"
		},
		"./sdk": {
			"types": "./sdk.d.ts",
			"default": "./sdk.js"
		},
		"./vite": {
			"@justfiles/src": "./vite-plugin.ts",
			"types": "./dist/vite-plugin.d.ts",
			"default": "./dist/vite-plugin.js"
		},
		"./host": {
			"@justfiles/src": "./host.ts",
			"types": "./dist/host.d.ts",
			"default": "./dist/host.js"
		},
		"./format": {
			"@justfiles/src": "./format.ts",
			"types": "./dist/format.d.ts",
			"default": "./dist/format.js"
		},
		"./virtual": {
			"types": "./virtual.d.ts"
		},
		"./runtime.js": {
			"@justfiles/src": "./runtime.ts",
			"types": "./dist/runtime.d.ts",
			"default": "./dist/runtime.js"
		},
		"./runner.js": {
			"@justfiles/src": "./runner.ts",
			"types": "./dist/runner.d.ts",
			"default": "./dist/runner.js"
		},
		"./capabilities-bridge.js": {
			"@justfiles/src": "./capabilities-bridge.ts",
			"types": "./dist/capabilities-bridge.d.ts",
			"default": "./dist/capabilities-bridge.js"
		},
		"./capabilities": {
			"@justfiles/src": "./capabilities/index.ts",
			"types": "./dist/capabilities/index.d.ts",
			"default": "./dist/capabilities/index.js"
		},
		"./capabilities/broker": {
			"@justfiles/src": "./capabilities/broker.ts",
			"types": "./dist/capabilities/broker.d.ts",
			"default": "./dist/capabilities/broker.js"
		},
		"./capabilities/email": {
			"@justfiles/src": "./capabilities/email/index.ts",
			"types": "./dist/capabilities/email/index.d.ts",
			"default": "./dist/capabilities/email/index.js"
		},
		"./capabilities/calendar": {
			"@justfiles/src": "./capabilities/calendar/index.ts",
			"types": "./dist/capabilities/calendar/index.d.ts",
			"default": "./dist/capabilities/calendar/index.js"
		},
		"./capabilities/volume": {
			"@justfiles/src": "./capabilities/volume/index.ts",
			"types": "./dist/capabilities/volume/index.d.ts",
			"default": "./dist/capabilities/volume/index.js"
		}
	},
	"files": [
		"dist",
		"client.js",
		"client.d.ts",
		"sdk.js",
		"sdk.d.ts",
		"virtual.d.ts"
	],
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"typebox": "^1.1.34",
		"vite": "^6 || ^7 || ^8"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typebox": "^1.1.34",
		"typescript": "^6.0.3",
		"vite": "^8.0.0-beta.13"
	}
}
