{
	"name": "@justfiles/app",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./index.ts",
		"./runtime": "./kernel.ts",
		"./browser": "./browser.ts",
		"./vite": "./vite.ts",
		"./dev-server": "./dev-server.ts",
		"./capabilities": "./capabilities/index.ts",
		"./capabilities/broker": "./capabilities/broker.ts",
		"./capabilities/email": "./capabilities/email/index.ts",
		"./capabilities/calendar": "./capabilities/calendar/index.ts",
		"./capabilities/volume": "./capabilities/volume/index.ts",
		"./capabilities/ai": "./capabilities/ai/index.ts",
		"./capabilities/integrations": "./capabilities/integrations/index.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./runtime": {
				"types": "./dist/kernel.d.ts",
				"default": "./dist/kernel.js"
			},
			"./browser": {
				"types": "./dist/browser.d.ts",
				"default": "./dist/browser.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			},
			"./dev-server": {
				"types": "./dist/dev-server.d.ts",
				"default": "./dist/dev-server.js"
			},
			"./capabilities": {
				"types": "./dist/capabilities/index.d.ts",
				"default": "./dist/capabilities/index.js"
			},
			"./capabilities/broker": {
				"types": "./dist/capabilities/broker.d.ts",
				"default": "./dist/capabilities/broker.js"
			},
			"./capabilities/email": {
				"types": "./dist/capabilities/email/index.d.ts",
				"default": "./dist/capabilities/email/index.js"
			},
			"./capabilities/calendar": {
				"types": "./dist/capabilities/calendar/index.d.ts",
				"default": "./dist/capabilities/calendar/index.js"
			},
			"./capabilities/volume": {
				"types": "./dist/capabilities/volume/index.d.ts",
				"default": "./dist/capabilities/volume/index.js"
			},
			"./capabilities/ai": {
				"types": "./dist/capabilities/ai/index.d.ts",
				"default": "./dist/capabilities/ai/index.js"
			},
			"./capabilities/integrations": {
				"types": "./dist/capabilities/integrations/index.d.ts",
				"default": "./dist/capabilities/integrations/index.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"vite": "^6 || ^7 || ^8"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^25.7.0",
		"esbuild": "^0.27.0",
		"typescript": "^6.0.3",
		"valibot": "^1.1.0",
		"vite": "^8.0.0-beta.13"
	},
	"dependencies": {
		"@justfiles/fs": "workspace:*",
		"@standard-schema/spec": "^1.1.0"
	}
}
