	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc && node scripts/verify-source-maps.ts && node scripts/build-devkit-sysroot.ts && cp dev-server.html dev-server.css dist/",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"esbuild": "^0.27.0",
		"typescript": "^5 || ^6",
		"vite": "^8"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		},
		"esbuild": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	},
	"devDependencies": {
		"@justfiles/tsconfig": "workspace:*",
		"@types/bun": "^1.3.0",
		"@types/node": "^25.7.0",
		"esbuild": "^0.27.0",
		"tsdown": "^0.21.10",
		"typescript": "catalog:",
		"valibot": "^1.1.0",
		"vite": "^8.0.0-beta.13"
	},
	"dependencies": {
		"@justfiles/design": "workspace:^",
		"@justfiles/fs": "workspace:*",
		"@standard-schema/spec": "^1.1.0",
		"capnweb": "^0.8.0",
		"fflate": "^0.8.3",
		"type-fest": "^5.6.0"
