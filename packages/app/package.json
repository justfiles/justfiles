{
	"name": "@justfiles/app",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./index.ts",
		"./sdk": "./sdk.ts",
		"./vite": "./vite-plugin.ts",
		"./format": "./format.ts",
		"./virtual": {
			"types": "./virtual.d.ts"
		},
		"./capabilities": "./capabilities/index.ts",
		"./capabilities/broker": "./capabilities/broker.ts",
		"./capabilities/email": "./capabilities/email/index.ts",
		"./capabilities/calendar": "./capabilities/calendar/index.ts",
		"./capabilities/volume": "./capabilities/volume/index.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./sdk": {
				"types": "./dist/sdk.d.ts",
				"default": "./dist/sdk.js"
			},
			"./vite": {
				"types": "./dist/vite-plugin.d.ts",
				"default": "./dist/vite-plugin.js"
			},
			"./format": {
				"types": "./dist/format.d.ts",
				"default": "./dist/format.js"
			},
			"./virtual": {
				"types": "./virtual.d.ts"
			},
			"./capabilities": {
				"types": "./dist/capabilities/index.d.ts",
				"default": "./dist/capabilities/index.js"
			},
			"./capabilities/broker": {
				"types": "./dist/capabilities/broker.d.ts",
				"default": "./dist/capabilities/broker.js"
			},
			"./capabilities/email": {
				"types": "./dist/capabilities/email/index.d.ts",
				"default": "./dist/capabilities/email/index.js"
			},
			"./capabilities/calendar": {
				"types": "./dist/capabilities/calendar/index.d.ts",
				"default": "./dist/capabilities/calendar/index.js"
			},
			"./capabilities/volume": {
				"types": "./dist/capabilities/volume/index.d.ts",
				"default": "./dist/capabilities/volume/index.js"
			}
		}
	},
	"files": [
		"dist",
		"virtual.d.ts"
	],
	"scripts": {
		"build": "tsc && bun build sdk.ts --target=browser --format=iife --outfile=dist/sdk.js",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"typebox": "^1.1.34",
		"vite": "^6 || ^7 || ^8"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/bun": "latest",
		"esbuild": "^0.27.0",
		"typebox": "^1.1.34",
		"typescript": "^6.0.3",
		"vite": "^8.0.0-beta.13"
	}
}
