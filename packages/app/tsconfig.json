{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"rootDir": ".",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedIndexedAccess": true,
		"types": ["bun"]
	},
	"include": [
		"index.ts",
		"protocol.ts",
		"sdk.ts",
		"vite-plugin.ts",
		"format.ts",
		"host.ts",
		"client.ts",
		"contract.ts",
		"app-loader.ts",
		"host-factory.ts",
		"manifest-loader.ts",
		"capabilities/**/*.ts"
	],
	"exclude": ["node_modules", "dist"]
}
