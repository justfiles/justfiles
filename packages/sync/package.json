{
	"name": "@justfiles/sync",
	"version": "0.1.0",
	"type": "module",
	"exports": {
		".": "./index.ts",
		"./path": "./path.ts",
		"./replica": "./replica.ts",
		"./wire": "./wire.ts",
		"./storage/mem": "./storage/mem.ts",
		"./storage/idb": "./storage/idb.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"module": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./path": {
				"types": "./dist/path.d.ts",
				"import": "./dist/path.js",
				"default": "./dist/path.js"
			},
			"./replica": {
				"types": "./dist/replica.d.ts",
				"import": "./dist/replica.js",
				"default": "./dist/replica.js"
			},
			"./wire": {
				"types": "./dist/wire.d.ts",
				"import": "./dist/wire.js",
				"default": "./dist/wire.js"
			},
			"./storage/mem": {
				"types": "./dist/storage/mem.d.ts",
				"import": "./dist/storage/mem.js",
				"default": "./dist/storage/mem.js"
			},
			"./storage/idb": {
				"types": "./dist/storage/idb.d.ts",
				"import": "./dist/storage/idb.js",
				"default": "./dist/storage/idb.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@justfiles/fs": "workspace:*",
		"idb": "^8.0.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@justfiles/tsconfig": "workspace:*",
		"@types/node": "^25.5.0",
		"fake-indexeddb": "^6.2.5",
		"tsdown": "^0.21.5",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
