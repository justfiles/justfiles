{
	"name": "justfiles-app",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/manifest.json",
	"keywords": [
		"justcomputer-app"
	],
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm build",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"check": "biome check . && tsc --noEmit && vitest run && vite build"
	},
	"dependencies": {
		"react": "^19",
		"react-dom": "^19",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6",
		"typescript": "^5.9.3",
		"vite": "^8.0.12",
		"@biomejs/biome": "2.4.15",
		"@types/node": "^22",
		"vitest": "^4.0.18"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
